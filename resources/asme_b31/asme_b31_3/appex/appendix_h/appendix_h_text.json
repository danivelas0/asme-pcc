    },
    {
     "kind": "equation",
     "text": "A (2.37)(112) 265 mm 2 1 = =",
     "indent": 6
    },
    {
     "kind": "paragraph",
     "marker": null,
     "indent": 0,
     "text": "Try fillet welds only"
    },
    {
     "kind": "equation",
     "text": "L 4 = (2.5)(2.37) = 5.9 mm",
     "indent": 7
    },
    {
     "kind": "equation",
     "text": "or (2.5)(1.24) = 3.1 mm",
     "indent": 7
    },

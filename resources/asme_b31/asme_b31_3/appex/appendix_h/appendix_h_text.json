    {
     "kind": "equation",
     "text": "X (5.9)(160 114.3) 270 mm 2 1 = − =",
     "indent": 5
    },
    {
     "kind": "equation",
     "text": "(0.5)(8.18) Leg dimension of weld = = 5.8 mm 0.707",
     "indent": 3
    },
    {
     "kind": "paragraph",
     "marker": null,
     "indent": 0,
     "text": "Reinforcement area in fillet welds"

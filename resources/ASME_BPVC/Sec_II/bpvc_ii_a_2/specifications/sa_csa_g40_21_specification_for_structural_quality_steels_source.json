          {
            "id": "/page/871/SectionHeader/9",
            "block_type": "SectionHeader",
            "html": "<h4><b>1.1</b> <i>Marking:</i></h4>",
            "polygon": [
              [
                61.71318054199219,
                289.75758361816406
              ],
              [
                123.68156433105469,
                289.75758361816406
              ],
              [
                123.68156433105469,
                302.9961853027344
              ],
              [
                61.71318054199219,

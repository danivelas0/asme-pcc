            "children": null,
            "section_hierarchy": {
              "1": "/page/873/SectionHeader/9"
            }
          },
          {
            "id": "/page/873/Text/13",
            "block_type": "Text",
            "html": "<p block-type=\"Text\"><i>(b)</i> Products that have been given the full heat treatment required by para. 6.3 shall be marked by the party performing the heat treatment with theletters designating the applicable heat treatment condition following the stamped steel name or number.</p>",
            "polygon": [
              [
                51.94647216796875,
                420.1757354736328
              ],
              [
                289.3303985595703,
                420.1757354736328
              ],
              [
                289.3303985595703,
                479.30535888671875
              ],
              [
                51.94647216796875,

              ]
            ],
            "bbox": [
              51.94647216796875,
              420.1757354736328,
              289.3303985595703,
              479.30535888671875
            ],
            "children": null,
            "section_hierarchy": {
              "1": "/page/873/SectionHeader/9"
            }
          },
          {
            "id": "/page/873/Text/15",
            "block_type": "Text",
            "html": "<p block-type=\"Text\"><i>(c)</i> Products that have received a normalizing treatment shall be marked \"+N.\" Products that have received a normalizing rolling treatment shall be marked \"+NR\" instead of \"+N.\"</p>",
            "polygon": [
              [
                51.974172592163086,
                477.94610595703125

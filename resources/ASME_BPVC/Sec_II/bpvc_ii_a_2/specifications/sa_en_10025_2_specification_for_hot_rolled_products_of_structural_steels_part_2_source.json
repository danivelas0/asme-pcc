          },
          {
            "id": "/page/873/Text/10",
            "block_type": "Text",
            "html": "<p block-type=\"Text\"><i>(a)</i> In addition to the marking requirements of this specification, all products required to be marked and material identification used on all documentation required by this specification are to be identified by this SA/EN specification designation.</p>",
            "polygon": [
              [
                51.74509048461914,
                362.6894073486328
              ],
              [
                288.9546890258789,
                362.6894073486328
              ],
              [
                288.9546890258789,
                421.9837951660156
              ],
              [
                51.74509048461914,
                421.9837951660156
              ]
            ],
            "bbox": [
              51.74509048461914,
              362.6894073486328,
              288.9546890258789,
              421.9837951660156

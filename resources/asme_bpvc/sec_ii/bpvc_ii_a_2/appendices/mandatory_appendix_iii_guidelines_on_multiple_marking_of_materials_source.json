          {
            "id": "/page/928/SectionHeader/1",
            "block_type": "SectionHeader",
            "html": "<h1><b>MANDATORY APPENDIX III</b> <b>GUIDELINES ON MULTIPLE MARKING OF MATERIALS</b></h1>",
            "polygon": [
              [
                110.39220428466797,
                96.60962677001953
              ],
              [
                517.5189514160156,
                96.60962677001953
              ],
              [
